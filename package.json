{
  "name": "drea-online-fashion",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "remix vite:dev",
    "build": "remix vite:build",
"start": "wrangler dev",
"typecheck": "tsc",
"deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply drea_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply drea_db --remote",
    "db:seed:local": "wrangler d1 execute drea_db --local --file=./seed/seed.sql",
    "db:seed:remote": "wrangler d1 execute drea_db --remote --file=./seed/seed.sql"
  },
  "dependencies": {
    "@remix-run/cloudflare": "^2.15.0",
    "@remix-run/cloudflare-pages": "^2.15.0",
    "@remix-run/react": "^2.15.0",
    "bcryptjs": "^2.4.3",
    "isbot": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "@remix-run/dev": "^2.15.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/bcryptjs": "^2.4.6",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-tsconfig-paths": "^5.1.3",
    "wrangler": "^3.90.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
